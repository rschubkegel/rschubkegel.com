---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import BaseLayout from '@layouts/BaseLayout.astro'

const imageModules = import.meta.glob<ImageMetadata>(
	'../../assets/images/sticky/*.{avif,gif,jpeg,jpg,png,webp}',
	{ eager: true, import: 'default' },
)

const images = Object.entries(imageModules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([, image]) => image)

const count = images.length
---

<BaseLayout colorScheme="dark" title="Sticky Notes" description="A stack of sketches on sticky notes.">
	<div class="stack">
		{images.map((image, index) => (
			<Image
				src={image}
				alt="Sticky note sketch"
				class="stack-image"
				style={`z-index: ${index + 1}`}
				draggable="false"
			/>
		))}
	</div>
</BaseLayout>

<style is:global>
	body {
		background-color: #222 !important;
	}

	#gradient-background,
	#noise-overlay {
		display: none;
	}
</style>

<style lang="scss">
	.stack {
		position: fixed;
		z-index: 1;
		inset: 0;
		width: 400px;
		height: 400px;
		margin: auto;
	}

	.stack-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		cursor: pointer;
		user-select: none;
	}
</style>

<script>
	const images = document.querySelectorAll<HTMLImageElement>('.stack-image')
	const count = images.length

	for (const image of images) {
		image.addEventListener('click', () => {
			const current = Number.parseInt(image.style.zIndex, 10) || 0
			image.style.zIndex = String(current - count)
		})
	}
</script>
